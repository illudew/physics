                           {'name': '3.3.23 梅涅劳斯定理',
                            'formula': '\\frac{AF}{FB}\\cdot\\frac{BD}{DC}\\cdot\\frac{CE}{EA}=1',
                            'explain': '若一条直线与三角形ABC的三边BC,CA,AB（或延长线）分别交于D,E,F，则上述乘积等于1。',
                            'deriv': '设D,E,F共线。过C作CG平行AB交DE于G。三角形CDG相似三角形BDE得CD/BD=CG/BE，三角形AFE相似三角形CGE得AF/CG=AE/CE。消去CG得 '
                                     'AF/FB*BD/DC*CE/EA=1。',
                            'ex': '',
                            'app': '',
                            'note': '逆定理也成立：若上述乘积为1，则D,E,F三点共线。常用于证明共线问题。',
                            'hist': '',
                            'ext': '',
                            'fig': '',
                            'figCap': ''},
                           {'name': '3.3.24 塞瓦定理',
                            'formula': '\\frac{BD}{DC}\\cdot\\frac{CE}{EA}\\cdot\\frac{AF}{FB}=1',
                            'explain': '若三角形ABC内一点O到三顶点连线AO,BO,CO分别交对边于D,E,F，则上述乘积等于1。',
                            'deriv': '设AD,BE,CF共点于O。对三角形ABE用梅涅劳斯定理（截线C-O-D），对三角形AEC截线B-O-F，两式相除整理得 '
                                     'BD/DC*CE/EA*AF/FB=1。',
                            'ex': '',
                            'app': '',
                            'note': '逆定理也成立。塞瓦定理常用于证明三线共点问题。',
                            'hist': '',
                            'ext': '',
                            'fig': '',
                            'figCap': ''}]},
