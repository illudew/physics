                                       'solid #cbd5e1;padding:6px">海伦公式，$s$ 半周长</td></tr><tr><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">三角形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=\\frac{1}{2}ab\\sin C$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">两边及夹角</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">矩形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=ab$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$a,b$ 长和宽</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">正方形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=a^2$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$a$ 边长</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">平行四边形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=ah$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$a$ 底，$h$ 高</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">菱形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=\\frac{1}{2}d_1d_2$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$d_1,d_2$ 对角线</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">梯形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=\\frac{(a+b)h}{2}$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$a,b$ 上下底，$h$ 高</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">圆</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=\\pi r^2$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$r$ 半径</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">扇形</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=\\frac{1}{2}lr=\\frac{n\\pi r^2}{360}$</td><td '
