                           {'name': '3.10.2 立体图形体积表面积公式表',
                            'formula': '',
                            'explain': '<table style="width:100%;border-collapse:collapse;font-size:14px;margin:8px '
                                       '0"><thead><tr style="background:#eef4fb"><th style="border:1px solid '
                                       '#cbd5e1;padding:6px">图形</th><th style="border:1px solid '
                                       '#cbd5e1;padding:6px">体积 $V$</th><th style="border:1px solid '
                                       '#cbd5e1;padding:6px">表面积 $S$</th><th style="border:1px solid '
                                       '#cbd5e1;padding:6px">备注</th></tr></thead><tbody><tr><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">长方体</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=abc$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=2(ab+bc+ca)$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$a,b,c$ 长宽高</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">正方体</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=a^3$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=6a^2$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$a$ 棱长</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">棱柱</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=Sh$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=S_{侧}+2S_{底}$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S$ 底面积，$h$ 高</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">棱锥</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=\\frac{1}{3}Sh$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=S_{侧}+S_{底}$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S$ 底面积，$h$ 高</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">棱台</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=\\frac{1}{3}h(S+\\sqrt{SS^\\prime}+S^\\prime)$</td><td '
                                       'style="border:1px solid #cbd5e1;padding:6px">$S=S_{侧}+S+S^\\prime$</td><td '
                                       'style="border:1px solid #cbd5e1;padding:6px">$S,S^\\prime$ '
                                       '上下底面积</td></tr><tr><td style="border:1px solid #cbd5e1;padding:6px">圆柱</td><td '
                                       'style="border:1px solid #cbd5e1;padding:6px">$V=\\pi r^2h$</td><td '
                                       'style="border:1px solid #cbd5e1;padding:6px">$S=2\\pi r^2+2\\pi rh$</td><td '
                                       'style="border:1px solid #cbd5e1;padding:6px">$r$ 底半径，$h$ 高</td></tr><tr><td '
                                       'style="border:1px solid #cbd5e1;padding:6px">圆锥</td><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">$V=\\frac{1}{3}\\pi r^2h$</td><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">$S=\\pi r^2+\\pi rl$</td><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">$l$ 母线长</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">圆台</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=\\frac{1}{3}\\pi h(R^2+Rr+r^2)$</td><td '
                                       'style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=\\pi(R^2+r^2)+\\pi(R+r)l$</td><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">$R,r$ 上下底半径</td></tr><tr><td style="border:1px '
                                       'solid #cbd5e1;padding:6px">球</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$V=\\frac{4}{3}\\pi R^3$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$S=4\\pi R^2$</td><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">$R$ 球半径</td></tr><tr><td style="border:1px solid '
                                       '#cbd5e1;padding:6px">球缺</td><td style="border:1px solid '
